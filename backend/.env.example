# ALLSEMIS backend environment.
# Copy to .env and fill in real values. Never commit .env.
# Every value below is a placeholder; none of them works as a credential.

# ---- Server ----
PORT=4000
NODE_ENV=development
# Number of proxies between the visitor and this app. 0 when running locally.
# Without this line the default is 1 on Render in production (Render sets RENDER=true)
# and 0 everywhere else. A value given here always wins over that default, so do not
# carry the 0 below over to Render: leave the variable out there, or set 1 or 2.
# Render alone (browsers call the Render address directly): 1.
# Render behind a frontend-host rewrite (for example Vercel forwards /api to Render): 2.
# The visitor's real address is needed for the per-IP rate limits. Use the exact
# count and never a higher one: a number that is too high lets a visitor forge the
# address. After deploying, check the request log: every request showing the same
# address means the number is too low.
TRUST_PROXY=0
LOG_LEVEL=info

# ---- Database (MongoDB Atlas connection string) ----
MONGODB_URI=

# ---- Frontend origin(s) allowed to call this API (comma separated, no trailing slash) ----
FRONTEND_URL=http://localhost:5173
# The public address of the website (an https origin in production, no trailing slash), used for
# the addresses in the sitemap (GET /api/public/sitemap.xml, served by the website at /sitemap.xml).
# Empty: the first FRONTEND_URL. Set it when the website moves to its own domain.
PUBLIC_SITE_URL=

# ---- Sessions ----
# Long random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_HOURS=12
# The SameSite value of the session cookie. An empty value means not set, which is lax.
# lax    : the default. The cookie is Lax when the frontend and the API are on the same site
#          (localhost, a Vercel /api rewrite, or api.<your-domain>), and None automatically
#          for a sign-in that comes from another site (the frontend on one domain calling
#          the API directly on another), where a browser refuses a Lax cookie.
# none   : always None. Use it when the frontend calls the API on another domain, to be
#          explicit. Requires HTTPS. The cookie is then a third-party cookie, and a browser
#          that blocks third-party cookies may refuse it.
# strict : never relaxed. Signing in works only when the frontend and the API are on the same site.
COOKIE_SAMESITE=lax
# Optional, e.g. .example.com when the API runs on a subdomain of the site
COOKIE_DOMAIN=

# =====================================================================
# External services
#
# Each of the three services below switches itself on: when all of its
# values are filled in, the real provider is used. While they are empty
# the development fallback is used instead (files and images under
# backend/.data/, emails written to the server log).
# The start-up log line "server.listening" shows what is in use:
#   fileStorage: b2 | local    mediaStorage: cloudinary | local    email: resend | log
#
# These values are secrets. They belong in this file on the server (or in
# the host's environment settings) and nowhere else: never in the frontend,
# never in a VITE_ variable, never in git.
# =====================================================================

# ---- Cloudinary (public website images) ----
# Cloudinary console: the cloud name, API key and API secret of your product environment.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder the images are uploaded into. Choose it once: images in another folder are left alone.
CLOUDINARY_FOLDER=allsemis

# ---- Backblaze B2 (private recruitment documents: resumes, attachments) ----
# Used through B2's S3-compatible API. The R2_* variables of the earlier provider are no longer read.
# The S3 endpoint of the bucket's region, with no path. Form: https://s3.<region>.backblazeb2.com
B2_ENDPOINT=
# The region: the <region> part of the endpoint. Optional when the endpoint names it. When both are set they must match.
B2_REGION=
# The bucket name. The bucket must stay private ("Files in bucket are: Private" in Backblaze).
B2_BUCKET_NAME=
# The keyID of an application key for this bucket (capabilities: readFiles, writeFiles, deleteFiles, listFiles).
B2_ACCESS_KEY_ID=
# The applicationKey that belongs to that keyID.
B2_SECRET_ACCESS_KEY=
# Lifetime of a signed download link, in seconds. 120 is also what the code uses without this line.
# A longer value such as 900 is accepted; a value over 3600 logs a warning.
SIGNED_URL_TTL_SECONDS=120

# ---- Resend (email) ----
# Resend dashboard: an API key.
RESEND_API_KEY=
# The sender, written as  ALLSEMIS <no-reply@your-domain>  or  no-reply@your-domain  (on Render: without
# quotation marks). Its domain must be verified in the Resend account: Resend refuses EVERY email from a
# domain that is not verified, the team notifications included. Not an address on gmail.com or another
# public mailbox domain, and not resend.dev except for a test to the Resend account's own address.
EMAIL_FROM=
# Where new requirement, application, enquiry and referral notifications are sent. Any inbox the
# team reads: this is a recipient, so it does not have to be on the sender's domain.
# Without it those notifications are not sent.
ADMIN_NOTIFICATION_EMAIL=

# ---- Drivers (optional, normally left out) ----
# The driver follows the credentials above, so these three lines are not needed.
# Setting one to the provider name forces that provider even when its credentials are
# incomplete: the feature then answers "not configured" instead of using the fallback.
# Setting one to local or log does NOT keep the fallback once the credentials are
# complete: to use the fallback for a while, leave one of the credentials empty.
# In production private documents always use B2 and images always use Cloudinary.
# Private documents: b2 | local. The earlier value r2 is ignored with a start-up warning.
# FILE_STORAGE_DRIVER=b2
# MEDIA_STORAGE_DRIVER=cloudinary
# EMAIL_DRIVER=resend

# ---- OpenAI (OPTIONAL: not needed to run or develop ALLSEMIS) ----
# Leave both values empty for local development. The whole application works without them:
# the website, the website assistant (rule-based, it never calls an AI service), jobs, job sync,
# applications, resume extraction, the rule-based ATS, ranking and skill gaps, and the admin.
# They are read only by the three existing admin AI actions: "Compare with AI" on an ATS result,
# "Draft with AI" on a job's requirement profile and "Compare candidates with AI" for a job.
# With either value empty those three buttons answer that AI is not set up. The code has no
# default model. ATS / resume shortlisting by AI is provided by the client's own API, outside
# this project. Semantic (embedding) matching and AI Job Intelligence are future scope.
OPENAI_API_KEY=
# The model name, exactly as OpenAI lists it for your account, for example:
# OPENAI_MODEL=gpt-5.4-mini
OPENAI_MODEL=
# The five values below are for the estimated AI usage shown in the admin. All are optional,
# none is a secret, and the AI actions work without them. OpenAI is used pay-as-you-go: ALLSEMIS
# has no budget and never limits, delays or refuses an AI request because of these values. The
# estimate is kept by this backend from the requests it sends: it is not OpenAI's billing, not the
# remaining OpenAI balance, and no OpenAI administrator key is used.
#
# AI usage alert thresholds, in estimated US dollars for the current usage period (the calendar
# month, UTC). When the estimated usage reaches one, the admin panel shows a Notice, Warning or
# Critical alert asking the admin to check the OpenAI account and add credits if needed.
# - They are alert thresholds only. They are NOT a monthly budget.
# - They do NOT limit OpenAI usage and do NOT block AI requests: AI keeps working past every one.
# - They do NOT represent OpenAI's remaining balance.
# Each is optional; empty (or 0) means no alert at that level. All empty: usage is still estimated
# and shown, with no alert. Set them rising from notice to critical, for example 5, 10 and 20.
AI_USAGE_NOTICE_USD=
AI_USAGE_WARNING_USD=
AI_USAGE_CRITICAL_USD=
# The price of the configured model in US dollars per million tokens, used only to estimate what
# each request cost. Set both or neither: one without the other is ignored with a start-up
# warning. Empty: for gpt-5.4-mini the built-in list price is used (0.75 input / 4.50 output, checked on 2026-10-06), and for any other model the
# spend cannot be estimated. Prices change: check OpenAI's pricing page and set both when they differ.
OPENAI_INPUT_COST_PER_1M_TOKENS=
OPENAI_OUTPUT_COST_PER_1M_TOKENS=

# ---- Official job source synchronisation (optional) ----
# Off until JOB_SYNC_SOURCE_URL is set. Field contract, behaviour and the production checklist:
# docs/JOB-SYNC.md. No official source is connected yet.
# json-feed (a JSON list of all open jobs) or jsonld-pages (schema.org JobPosting on job pages).
JOB_SYNC_SOURCE_TYPE=json-feed
JOB_SYNC_SOURCE_URL=
# The identity stored on each imported job. Do not change it after the first run.
JOB_SYNC_SOURCE_KEY=company-site
JOB_SYNC_SOURCE_NAME=Company website
# jsonld-pages only: a regular expression the job page addresses match.
JOB_SYNC_LINK_PATTERN=
# Run inside the server every N minutes. 0 = off (use npm run sync:jobs or the endpoint instead).
JOB_SYNC_INTERVAL_MINUTES=0
# Consecutive complete runs a job may be missing from the source before it is archived.
JOB_SYNC_MISSING_THRESHOLD=2
# published or draft: the status of a newly imported job.
JOB_SYNC_NEW_STATUS=published
# Bearer token for POST /api/internal/job-sync, 32+ characters. Empty: the endpoint is off. A secret.
JOB_SYNC_TOKEN=

# ---- Development seed only (npm run seed). Leave empty to have passwords generated and printed once. ----
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
